{
  "name": "media-symlink3r",
  "version": "3.0.0",
  "description": "High-performance DrivePool & qBittorrent media deduplication, symlink healer, and disaster recovery catalog (Electron + TypeScript)",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@node-rs/xxhash": "^1.6.1",
    "hash-wasm": "^4.13.0",
    "koffi": "^2.9.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "koffi@2.16.3": true
  }
}
